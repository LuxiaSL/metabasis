# ── Repo policy: git tracks CODE ONLY (+ eventually paper/tex, by explicit
# ── decision). Results, banks, docs, and research logs live in the working
# ── tree but never on the remote.
outputs/
# Enactor pull-back landing zone: banks/stamps/fits/logs rsynced off the
# collection node, staged for desk verification before it integrates them into
# outputs/. Same policy as outputs/ — results never push.
staging/
docs/*
!docs/planning/
docs/planning/*
!docs/planning/PREREG-*.md
research/
*.log
# Enactor pull-backs awaiting desk integration into outputs/ (same policy as
# outputs/: results never travel with a commit).
staging/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# Env / secrets — never committed, values live in the local off-repo runbook
.env
*.key

# Editor / OS noise
.vscode/
.idea/
.DS_Store

# Session tooling (local-only)
CLAUDE.md
.claude/
