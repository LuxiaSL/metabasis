#!/usr/bin/env bash
{{*header}}
set -u
set -o pipefail

MODEL="{{model}}"
MODEL_PATH="{{model_path}}"
ARMS="{{arms}}"
SITES="{{sites}}"
SPOT_K="{{spot_replay_k}}"
{{#if has_max_seq_len}}
MAX_SEQ_LEN="{{max_seq_len}}"
{{/if}}
{{#if mem_sharded}}
SHARD_ACROSS="{{shard_across}}"
{{/if}}
{{corpus_var}}="{{corpus_sha}}"

ROOT="{{root}}"
CODE="$ROOT/{{code_dirname}}"
ARM="$ROOT/{{arm_dirname}}"
BANKROOT="{{bankroot}}"
TS="$(date +%Y%m%d-%H%M%S)"
LOG="$BANKROOT/logs/{{log_stem}}-$MODEL-$TS.log"

cd "$CODE" || { echo "PREFLIGHT-BLOCKED: $CODE absent — wrong node?"; exit 2; }
mkdir -p "$BANKROOT/logs" || { echo "PREFLIGHT-BLOCKED: cannot make out dirs"; exit 2; }

if [ -z "${CUDA_VISIBLE_DEVICES:-}" ]; then
  echo "PREFLIGHT-BLOCKED: CUDA_VISIBLE_DEVICES unset — must run under the scheduler"
  exit 2
fi
have=$(sha256sum "$ARM/{{corpus_manifest_relpath}}" | cut -d' ' -f1)
if [ "$have" != "${{corpus_var}}" ]; then
  echo "PREFLIGHT-BLOCKED: {{arm_dirname}} corpus sha $have != {{corpus_label}} ${{corpus_var}}"; exit 2
fi

# shellcheck disable=SC1091
source "{{venv_activate}}" || { echo "PREFLIGHT-BLOCKED venv"; exit 2; }
export PYTHONUNBUFFERED=1
{{#if thread_ruling_note}}
{{*thread_ruling_lines}}
{{/if}}
export OMP_NUM_THREADS={{omp_num_threads}}
export TOKENIZERS_PARALLELISM=false
export HF_HUB_OFFLINE=1

echo "host $(hostname)  model $MODEL  arms $ARMS  cvd=$CUDA_VISIBLE_DEVICES"
echo "code $CODE   arm-root $ARM   sites $SITES   spot-replay K=$SPOT_K"
echo "{{corpus_label}} verified in place: ${{corpus_var}}   log $LOG"

python - "$MODEL" "$SITES" "$ARM" "${{corpus_var}}" "$ARMS" <<'PREFLIGHT'
import hashlib, json, sys
from pathlib import Path

model, sites, arm_root, corpus_sha, arms = sys.argv[1:6]

# --- the node must not be BLOCKED, and the block lives in the registry -------
from metabasis.roster import ROSTER, SCAN_GRIDS, blocked_nodes
blocked = blocked_nodes()
if model in blocked:
    print(f"PREFLIGHT-BLOCKED: {model} is registry-BLOCKED ({blocked[model]}) — "
          "the block is cleared by a desk ruling, never by a job"); sys.exit(2)

# --- the grid is DERIVED from the registry and ASSERTED against the staged one
# Sites from curves, never fiat (prereg §4): a grid typed into a job script is a
# grid nobody can re-derive from a checkpoint's config.json.
staged = tuple(int(s) for s in sites.split(",") if s.strip())
if model in SCAN_GRIDS:
    registry = tuple(SCAN_GRIDS[model])
    if staged != registry:
        print(f"PREFLIGHT-BLOCKED: staged grid {staged} != registry grid "
              f"{registry}. The registry is the authority; a job that collects "
              f"a different grid banks a curve nobody can reproduce"); sys.exit(2)
    print(f"preflight: grid DERIVED — SCAN_GRIDS[{model}] = {registry}")
else:
    print(f"PREFLIGHT-BLOCKED: {model} carries no scan grid in the registry, so "
          f"the staged grid {staged} is fiat"); sys.exit(2)

# --- the DEVIATIONS travel with the node, not with this script ---------------
# max_seq_len lives in the registry so collection, spot-replay, target builds and
# behavioural reads cannot silently disagree — prereg ADDENDUM 2026-07-27-B wants
# ONE truncation for all uses of a node.
node = ROSTER[model]
wanted = node.collector_args
print(f"preflight: registry deviations for {model}: "
      f"{wanted if wanted else 'none'}")

# --- the arms are the ones the roster row asks for ---------------------------
staged_arms = tuple(a for a in arms.split(",") if a.strip())
unknown = [a for a in staged_arms if a not in node.arms]
if unknown:
    print(f"PREFLIGHT-BLOCKED: arm(s) {unknown} are not on roster row "
          f"{node.roster_row} ({node.arms})"); sys.exit(2)

# --- the corpus, asserted from the manifest bytes AND through the loader -----
man = Path(arm_root) / "corpus" / "corpus_manifest.json"
on_disk = hashlib.sha256(man.read_bytes()).hexdigest()
if on_disk != corpus_sha:
    print(f"PREFLIGHT-BLOCKED: corpus_manifest.json sha {on_disk} != ruled "
          f"{corpus_sha}"); sys.exit(2)
from metabasis.scripts.collect_mean_states import load_corpus
entries, manifest_sha = load_corpus(Path(arm_root))
if manifest_sha != corpus_sha:
    print(f"PREFLIGHT-BLOCKED: the loader reads {manifest_sha} where the bytes "
          f"hash {on_disk} — the two must not be able to disagree"); sys.exit(2)
{{#if has_n_texts}}
if len(entries) != {{corpus_n_texts}}:
    print(f"PREFLIGHT-BLOCKED: corpus has {len(entries)} entries, not "
          f"{{corpus_n_texts}}"); sys.exit(2)
{{/if}}
print(f"preflight: corpus = {corpus_sha[:12]}…, {len(entries)} texts at {man}")
print("preflight ok")
PREFLIGHT
rc=$?
if [ "$rc" -ne 0 ]; then echo "{{marker}}-PREFLIGHT-BLOCKED $MODEL"; exit 2; fi

if [ "${MB_PREFLIGHT_ONLY:-0}" = "1" ]; then
  echo "{{marker}}-PREFLIGHT-ONLY-OK $MODEL (nothing collected)"; exit 0
fi

# --- COLLECT + FRESH-PROCESS BITWISE SPOT-REPLAY IN ONE JOB ------------------
# The standing gate. One job, because a replay in a SEPARATE job certifies a
# different process's determinism than the one that wrote the bank.
# ⚠ EXIT 0 IS NOT THE VERDICT: the verdict is ALL_BITWISE_EXACT in the spot
# report, and a False there is a HALT, never a resubmit.
echo "=== COLLECT $MODEL arms=$ARMS sites=$SITES + spot-replay K=$SPOT_K ==="
python -m metabasis.scripts.collect_mean_states \
  --model "$MODEL" --model-path "$MODEL_PATH" --arm-root "$ARM" \
  --arms "$ARMS" --sites "$SITES" \
  --collect --spot-replay "$SPOT_K" \
{{#if has_max_seq_len}}
  --max-seq-len "$MAX_SEQ_LEN" \
{{/if}}
{{#if mem_sharded}}
  --shard-across "$SHARD_ACROSS" \
{{/if}}
{{#if assert_multi_device}}
  --assert-multi-device \
{{/if}}
  2>&1 | tee -a "$LOG"
rc=${PIPESTATUS[0]}

if [ "$rc" -eq 0 ]; then
  echo "{{marker}}-JOB-OK $MODEL arms=$ARMS sites=$SITES corpus={{corpus_tag}} spot_k=$SPOT_K"
  echo "(read ALL_BITWISE_EXACT in the spot report above — the artifact is the"
  echo " verdict, not this line; a False there is a HALT, not a resubmit)"
  exit 0
fi
echo "{{marker}}-JOB-NONZERO-RC=$rc $MODEL"
exit "$rc"
